# Connexion directe (non poolée) recommandée pour un worker à connexion
# longue-durée — le pooler Neon est pensé pour du serverless éclaté, pas
# pour une seule connexion qui reste ouverte en permanence.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Même valeur que R2_PUBLIC_URL côté apps/web (lecture publique uniquement
# — ce worker n'a pas besoin des clés R2, juste de l'URL publique).
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# Backbone — voir docs/ai-worker-benchmark pour le choix (SigLIP-large,
# benchmark réel sur ce VPS : ~1,9 Go pic RAM, ~5s/image CPU).
SIGLIP_MODEL_ID="google/siglip-large-patch16-256"

# Intervalle d'attente quand la file est vide (ms).
POLL_INTERVAL_MS=5000

# Fréquence du balayage de récupération des jobs bloqués (s) et seuil
# d'ancienneté (min) au-delà duquel un job "PROCESSING" est considéré
# planté et remis en PENDING.
RECLAIM_INTERVAL_S=600
RECLAIM_STALE_MINUTES=30

# Port du endpoint /health, lié à 127.0.0.1 uniquement (voir compose.yaml).
HEALTH_PORT=8092

# Timeout de téléchargement d'image (s).
HTTP_TIMEOUT_S=20
