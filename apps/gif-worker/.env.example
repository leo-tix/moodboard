# Jeton partagé — doit être IDENTIQUE à GIF_WORKER_TOKEN côté apps/web
# (Vercel). Générer avec : openssl rand -hex 32
GIF_WORKER_TOKEN=""

# Origines autorisées (CORS) à appeler ce service directement depuis le
# navigateur, séparées par des virgules. Défaut si absent :
# "https://moodboard.leotix.fr,http://localhost:3000"
ALLOWED_ORIGIN=""

PORT=8091
# 1,5 Go — la vidéo source n'est jamais conservée, seul le GIF recadré repart.
MAX_UPLOAD_BYTES=1610612736
MAX_DURATION_S=15
MAX_WIDTH=480
DEFAULT_FPS=12
MAX_FPS=20
MAX_CONCURRENCY=1
FFMPEG_TIMEOUT_MS=90000

# ------------------------------------------------------------
# Import vidéo par lien (TikTok / Instagram / générique → GIF)
# ------------------------------------------------------------
# yt-dlp : 500 Mo / 10 min — cohérent avec les plafonds vérifiés côté
# apps/web (/api/video-link/ticket) avant l'émission du ticket, mais c'est
# CE service qui fait foi (le ticket n'est pas lié à une URL précise).
YTDLP_BIN=yt-dlp
YTDLP_MAX_CONCURRENCY=1
MAX_FETCH_BYTES=524288000
MAX_FETCH_DURATION_S=600
FETCH_TIMEOUT_MS=180000
META_TIMEOUT_MS=30000
# Sous-flux YouTube (#7, /fetch-url-section) : plafond de la SECTION
# téléchargée (pas la vidéo entière) — bien plus bas que MAX_FETCH_DURATION_S.
MAX_FETCH_SECTION_DURATION_S=120
