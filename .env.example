# ============================================================
# BASE DE DONNÉES — Neon PostgreSQL
# ============================================================
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ============================================================
# AUTHENTIFICATION — NextAuth
# ============================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Credentials admin (toi seul)
ADMIN_EMAIL="ton@email.com"
ADMIN_PASSWORD_HASH="bcrypt hash de ton mot de passe"

# ------------------------------------------------------------
# DOUBLE AUTHENTIFICATION (2FA / TOTP)
# ------------------------------------------------------------
# Clé de chiffrement des secrets TOTP stockés en base (AES-256-GCM).
# 32 octets en base64 : openssl rand -base64 32
# Optionnelle : si absente, la clé est dérivée de NEXTAUTH_SECRET.
# ATTENTION : changer cette clé (ou NEXTAUTH_SECRET si on s'appuie dessus)
# rend illisibles les secrets existants → les comptes concernés doivent
# réactiver la 2FA depuis Réglages › Compte.
TWO_FACTOR_ENCRYPTION_KEY=""

# ============================================================
# STOCKAGE — Cloudflare R2
# ============================================================
R2_ACCOUNT_ID="ton-account-id"
R2_ACCESS_KEY_ID="ton-access-key"
R2_SECRET_ACCESS_KEY="ton-secret-key"
R2_BUCKET_NAME="moodboard"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
