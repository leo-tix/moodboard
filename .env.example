# ============================================================
# BASE DE DONNÉES — Neon PostgreSQL
# ============================================================
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ============================================================
# AUTHENTIFICATION — NextAuth
# ============================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Credentials admin (toi seul)
ADMIN_EMAIL="ton@email.com"
ADMIN_PASSWORD_HASH="bcrypt hash de ton mot de passe"

# ------------------------------------------------------------
# DOUBLE AUTHENTIFICATION (2FA / TOTP)
# ------------------------------------------------------------
# Clé de chiffrement des secrets TOTP stockés en base (AES-256-GCM).
# 32 octets en base64 : openssl rand -base64 32
# Optionnelle : si absente, la clé est dérivée de NEXTAUTH_SECRET.
# ATTENTION : changer cette clé (ou NEXTAUTH_SECRET si on s'appuie dessus)
# rend illisibles les secrets existants → les comptes concernés doivent
# réactiver la 2FA depuis Réglages › Compte.
TWO_FACTOR_ENCRYPTION_KEY=""

# ============================================================
# STOCKAGE — Cloudflare R2
# ============================================================
R2_ACCOUNT_ID="ton-account-id"
R2_ACCESS_KEY_ID="ton-access-key"
R2_SECRET_ACCESS_KEY="ton-secret-key"
R2_BUCKET_NAME="moodboard"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------
# CARTES — tuiles CARTO (mode visite)
# ------------------------------------------------------------
# CARTO exige désormais une clé pour ses basemaps hors de sa plateforme
# (sinon filigrane "API KEY REQUIRED" sur les tuiles). Clé gratuite
# (5M requêtes/mois, usage non commercial) en quelques secondes, sans
# compte : https://carto.com/basemaps/apikey/
# Optionnelle : sans elle, les cartes fonctionnent mais sont filigranées.
NEXT_PUBLIC_CARTO_API_KEY=""

# ------------------------------------------------------------
# VIDÉO → GIF — service dédié sur le VPS (apps/gif-worker)
# ------------------------------------------------------------
# URL de l'endpoint /convert du worker (voir apps/gif-worker) et jeton
# partagé (IDENTIQUE à GIF_WORKER_TOKEN côté worker). Sans eux, l'upload
# vidéo→GIF (fichier local ET import par lien) est désactivé.
GIF_WORKER_URL="https://gif.leotix.fr/convert"
GIF_WORKER_TOKEN=""
GIF_MAX_DURATION_S=15
GIF_MAX_UPLOAD_BYTES=1610612736

# Import vidéo par lien (TikTok / Instagram / générique) — plafond
# quotidien par profil, illimité pour ADMIN. Les limites sur la vidéo
# SOURCE (durée/poids avant téléchargement) sont dans apps/gif-worker/.env.
VIDEO_LINK_DAILY_LIMIT=20
